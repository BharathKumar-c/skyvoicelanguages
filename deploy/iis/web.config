<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS reverse proxy for the Sky Voice Languages Next.js site.
  See document/WINDOWS_SERVER_DEPLOYMENT_GUIDE.md.

  - Copy this file to the IIS site's physical folder (C:\inetpub\skyvoicelanguages\web.config).
  - IIS serves NO files from that folder except Let's Encrypt challenge files;
    everything else is forwarded to Next.js on http://127.0.0.1:3000 (the "skyvoice-web" Windows service).
  - Requires: IIS URL Rewrite 2.1 + Application Request Routing 3.0 (proxy enabled,
    preserveHostHeader=true), and the server variables HTTP_X_FORWARDED_FOR,
    HTTP_X_FORWARDED_HOST, HTTP_X_FORWARDED_PROTO allowed at server level.
  - Rules 2 and 3 (HTTPS and www redirects) ship DISABLED. Enable them only after the
    HTTPS binding works (guide, step 10).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- 1. Let win-acme's Let's Encrypt validation files be served by IIS itself. -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>

        <!-- 2. HTTP -> HTTPS. Enable after the 443 binding and certificate work. -->
        <rule name="Redirect to HTTPS" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 3. www -> bare domain (the site's canonical URLs use the bare domain). -->
        <rule name="Redirect www to apex" enabled="false" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTP_HOST}" pattern="^www\.skyvoicelanguages\.com$" />
          </conditions>
          <action type="Redirect" url="https://skyvoicelanguages.com/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- 4. Everything else goes to Next.js. {UNENCODED_URL} keeps the original encoded
             path and query string (e.g. /_next/image?url=%2F...). -->
        <rule name="Proxy to Next.js" stopProcessing="true">
          <match url="(.*)" />
          <conditions trackAllCaptures="true">
            <add input="{CACHE_URL}" pattern="^(https?)://" />
          </conditions>
          <serverVariables>
            <!-- Real client IP for the form rate limiter (replaces any client-sent value). -->
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <!-- Public host for the admin panel's Server Actions origin check. -->
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="{C:1}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000{UNENCODED_URL}" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>

    <!-- Next.js already compresses responses; avoid compressing them twice. -->
    <urlCompression doStaticCompression="false" doDynamicCompression="false" />

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
