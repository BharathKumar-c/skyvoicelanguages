# Server-only endpoint that receives validated assessment leads.
ASSESSMENT_LEAD_WEBHOOK_URL=

# Optional bearer token sent to the lead webhook.
ASSESSMENT_LEAD_WEBHOOK_TOKEN=

# Public service-introduction video shown on /free-ielts-assessment.
# Leave empty until the approved video is available (the section then shows a
# preview and the written overview). Example: /video/service-intro.mp4
NEXT_PUBLIC_SERVICE_VIDEO_SRC=
# Optional: MIME type (default video/mp4) and WebVTT captions path.
NEXT_PUBLIC_SERVICE_VIDEO_TYPE=
NEXT_PUBLIC_SERVICE_VIDEO_CAPTIONS=

# Short teaser shown in the hero, above the assessment form. Independent of the
# service video above; leave empty until available.
NEXT_PUBLIC_HERO_VIDEO_SRC=
NEXT_PUBLIC_HERO_VIDEO_TYPE=
NEXT_PUBLIC_HERO_VIDEO_CAPTIONS=

# Optional: separate webhook for Contact-page enquiries. When unset, enquiries
# go to ASSESSMENT_LEAD_WEBHOOK_URL tagged with type "contact-enquiry".
CONTACT_ENQUIRY_WEBHOOK_URL=
CONTACT_ENQUIRY_WEBHOOK_TOKEN=
