# Server-only endpoint that receives validated assessment leads.
ASSESSMENT_LEAD_WEBHOOK_URL=

# Optional bearer token sent to the lead webhook.
ASSESSMENT_LEAD_WEBHOOK_TOKEN=

# Public service-introduction video shown on /free-ielts-assessment.
# Leave empty until the approved video is available (the section then shows a
# preview and the written overview). Example: /video/service-intro.mp4
NEXT_PUBLIC_SERVICE_VIDEO_SRC=
# Optional: MIME type (default video/mp4) and WebVTT captions path.
NEXT_PUBLIC_SERVICE_VIDEO_TYPE=
NEXT_PUBLIC_SERVICE_VIDEO_CAPTIONS=

# Short teaser shown in the hero, above the assessment form. Independent of the
# service video above; leave empty until available.
NEXT_PUBLIC_HERO_VIDEO_SRC=
NEXT_PUBLIC_HERO_VIDEO_TYPE=
NEXT_PUBLIC_HERO_VIDEO_CAPTIONS=

# Optional: separate webhook for Contact-page enquiries. When unset, enquiries
# go to ASSESSMENT_LEAD_WEBHOOK_URL tagged with type "contact-enquiry".
CONTACT_ENQUIRY_WEBHOOK_URL=
CONTACT_ENQUIRY_WEBHOOK_TOKEN=

# Email delivery for the assessment and contact forms (server-only, optional;
# can run alongside the webhooks above). Each submission is emailed to
# NOTIFY_EMAIL_TO when SMTP_HOST, SMTP_USER, SMTP_PASS and NOTIFY_EMAIL_TO are
# all set. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=the Gmail
# address, SMTP_PASS=a 16-character Google App Password (NOT the account
# password; requires 2-Step Verification). Never commit real values.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Recipient inbox (comma-separate several addresses).
NOTIFY_EMAIL_TO=
# Optional sender, e.g. "Sky Voice website <you@gmail.com>". Gmail only allows
# the account's own address or a verified alias. Defaults to SMTP_USER.
NOTIFY_EMAIL_FROM=

# ---- Website Settings admin (/admin) — server-only ----
# Generate both values with: pnpm --filter @skyvoice/web admin:hash-password
# Until ADMIN_PASSWORD_HASH and ADMIN_SESSION_SECRET are set, /admin stays locked.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
# Local development only (ignored in production): plain-text password instead of the hash.
# ADMIN_PASSWORD=

# Where Website Settings are stored (JSON). Default: apps/web/data/site-settings.json.
# Needs a persistent disk; back this file up. Serverless hosts need a database
# adapter instead (see src/lib/settings/store.ts).
SETTINGS_FILE=

# WhatsApp automation via WATI (prepared; not yet wired). Endpoint and template
# name are entered in Website Settings → Integrations; the token stays here.
WATI_API_TOKEN=
